{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulp.audio/schemas/visual-parity-manifest-v1.json",
  "title": "Pulp source-to-native visual parity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "candidate", "freshness", "baseline_provenance", "backdrop", "masks", "thresholds", "critical_regions", "threshold_approval", "calibration"],
  "properties": {
    "schema": {"const": "pulp-visual-parity-manifest-v1"},
    "source": {"$ref": "#/$defs/artifact"},
    "candidate": {"$ref": "#/$defs/artifact"},
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["max_age_seconds"],
      "properties": {"max_age_seconds": {"type": "integer", "minimum": 1}}
    },
    "baseline_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["captured_by", "source_revision", "renderer_version", "regeneration_reason", "reviewed_by", "review_commit"],
      "properties": {
        "captured_by": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "renderer_version": {"type": "string", "minLength": 1},
        "regeneration_reason": {"type": "string", "minLength": 1},
        "reviewed_by": {"type": "string", "minLength": 1},
        "review_commit": {"type": "string", "minLength": 1}
      }
    },
    "backdrop": {
      "type": "object",
      "required": ["policy", "tier"],
      "properties": {
        "policy": {"enum": ["opaque-tier", "pinned-backdrop", "reviewed-mask"]},
        "tier": {"type": "string", "minLength": 1},
        "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "masks": {"type": "array", "items": {"$ref": "#/$defs/mask"}},
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["metric"],
      "properties": {"metric": {"const": "normalized-rgb-l2-v1"}}
    },
    "critical_regions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "rect", "minimum_pixel_similarity"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "rect": {"$ref": "#/$defs/rect"},
          "minimum_pixel_similarity": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "threshold_approval": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_sha256", "reviewed_by", "review_commit", "rationale"],
      "properties": {
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "reviewed_by": {"type": "string", "minLength": 1},
        "review_commit": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": ["source_repeats", "candidate_repeats", "source_minimum_pixel_similarity", "candidate_minimum_pixel_similarity"],
      "properties": {
        "source_repeats": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/artifact"}},
        "candidate_repeats": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/artifact"}},
        "source_minimum_pixel_similarity": {"type": "number", "minimum": 0, "maximum": 1},
        "candidate_minimum_pixel_similarity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rect": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}
      }
    },
    "font": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "path", "sha256"],
      "properties": {"family": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "width", "height", "dpr", "backend", "fonts", "captured_at", "revision"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "dpr": {"type": "number", "exclusiveMinimum": 0}, "backend": {"type": "string", "minLength": 1},
        "fonts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/font"}},
        "captured_at": {"type": "string", "format": "date-time"}, "revision": {"type": "string", "minLength": 1}
      }
    },
    "mask": {
      "type": "object", "additionalProperties": false,
      "required": ["rect", "reason", "reviewed_by", "review_commit"],
      "properties": {
        "rect": {"$ref": "#/$defs/rect"}, "reason": {"type": "string", "minLength": 1},
        "reviewed_by": {"type": "string", "minLength": 1}, "review_commit": {"type": "string", "minLength": 1}
      }
    }
  }
}
