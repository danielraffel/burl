{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulp.audio/schemas/runtime-source-capture-v1.json",
  "type": "object",
  "required": ["schema", "policy", "page", "observedDom", "snapshot", "styleProvenanceByDomOrder", "hostCalls"],
  "properties": {
    "schema": { "const": "pulp-runtime-source-capture-v1" },
    "policy": {
      "type": "object",
      "required": ["viewport", "clock", "settleFrames", "animations", "transitions", "network", "hostServices"],
      "properties": {
        "animations": { "const": "captured-before-disabled" }, "transitions": { "const": "disabled" },
        "network": { "const": "external-denied-source-origin-allowed" }, "hostServices": { "const": "recording-fake" }
      }
    },
    "page": { "type": "object" },
    "observedDom": { "$ref": "./observed-dom.schema.json" },
    "snapshot": { "type": "object" },
    "styleProvenanceByDomOrder": {
	  "type": "array",
	  "items": {
        "type": "object", "required": ["computed", "declarations", "matchedStylesCapture"],
        "properties": {
          "computed": { "type": "object", "additionalProperties": { "type": "string" } },
          "matchedStylesCapture": { "enum": ["complete", "omitted"] },
          "declarations": { "type": "object", "additionalProperties": { "type": "array", "items": {
            "type": "object", "required": ["value", "origin"],
            "properties": {
              "value": { "type": "string" },
              "origin": { "enum": ["authored", "inherited", "ua"] },
              "important": { "type": "boolean" },
              "selector": { "type": "string" },
              "range": { "type": ["object", "null"] },
              "media": { "type": "array", "items": { "type": "string" } }
            }
          } } }
	  }
      }
    },
    "hostCalls": { "type": "array" }
  }
}
